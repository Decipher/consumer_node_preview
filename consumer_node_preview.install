<?php

/**
 * @file
 * Install, update and uninstall functions for Consumer Node Preview.
 */

declare(strict_types=1);

/**
 * Adds the expires column to the stored preview targets.
 *
 * Drupal won't change a field's columns while it holds data, which a site
 * with registered targets does. So the column is added in place, and the
 * targets stay as they were. A run that stopped after adding the column
 * records it on the next run.
 */
function consumer_node_preview_update_10001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $definition = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('consumer')['preview_targets'] ?? NULL;
  if (!$definition || !$manager->getFieldStorageDefinition('preview_targets', 'consumer')) {
    return 'Consumers have no preview targets field. Nothing to update.';
  }

  /** @var \Drupal\Core\Entity\Sql\SqlEntityStorageInterface $storage */
  $storage = \Drupal::entityTypeManager()->getStorage('consumer');
  $mapping = $storage->getTableMapping();
  $table = $mapping->getFieldTableName('preview_targets');
  $column = $mapping->getFieldColumnName($definition, 'expires');
  $schema = \Drupal::database()->schema();
  $key_value = \Drupal::keyValue('entity.storage_schema.sql');
  $key = 'consumer.field_schema_data.preview_targets';
  $stored = $key_value->get($key, []);

  $exists = $schema->fieldExists($table, $column);
  if ($exists && isset($stored[$table]['fields'][$column])) {
    return 'The expires column is already in place.';
  }

  // As Drupal builds the column of a field's own table: the field type's
  // column, NOT NULL only for a required property.
  $spec = $definition->getSchema()['columns']['expires'];
  $spec['not null'] = (bool) $definition->getPropertyDefinition('expires')?->isRequired();
  if (!$exists) {
    $schema->addField($table, $column, $spec);
  }

  // Record the column as installed, so Drupal reports no pending change.
  $stored[$table]['fields'][$column] = $spec;
  $key_value->set($key, $stored);
  \Drupal::service('entity.last_installed_schema.repository')->setLastInstalledFieldStorageDefinition($definition);

  return $exists
    ? sprintf('Recorded %s on %s as installed.', $column, $table)
    : sprintf('Added %s to %s.', $column, $table);
}
